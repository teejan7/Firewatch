# Optional FIRMS API access for the separate local FastAPI service.
# The static dashboard does not need a key or a backend.
FIRMS_MAP_KEY=your-free-firms-map-key

# Optional local development overrides.
FIREWATCH_API_PORT=8000
FIREWATCH_WEB_PORT=5173
