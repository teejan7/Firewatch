{
  "name": "firewatch-dashboard",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "test": "npm test --workspace frontend",
    "api": "python -m uvicorn app.main:app --reload --app-dir backend",
    "typecheck": "tsc -b frontend/tsconfig.json",
    "lint": "eslint frontend/src scripts",
    "backend:check": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/check.ps1",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run backend:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  }
}
